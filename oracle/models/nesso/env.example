# Copy to .env and edit; deploy/run.sh sources it.

ORACLE_MODEL=nesso
ORACLE_GPUS=0,1,2,3,4,5,6,7
ORACLE_HOST=127.0.0.1
ORACLE_PORT=8000
ORACLE_TOKEN=
ORACLE_DB=nesso.db
NESSO_EMBEDDINGS_DIR=embeddings

# Tuning overrides; unset means the defaults in README.md.
# ORACLE_SHARDS_PER_GPU=4
# ORACLE_STAGGER_S=2
# ORACLE_REQUEST_TIMEOUT_S=900
# ORACLE_RECYCLE_RSS_GB=8
# ORACLE_MAX_BATCH=512

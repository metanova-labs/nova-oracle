# Copy to .env and edit; deploy/run.sh sources it.

ORACLE_MODEL=boltz2
ORACLE_GPUS=0,1,2,3,4,5,6,7
ORACLE_HOST=127.0.0.1
ORACLE_PORT=8000
ORACLE_TOKEN=
ORACLE_DB=boltz2.db
BOLTZ2_MSA_DIR=msa

# Tuning overrides; unset means the defaults in README.md.
# ORACLE_SHARDS_PER_GPU=3
# ORACLE_STAGGER_S=2
# ORACLE_REQUEST_TIMEOUT_S=900
# ORACLE_RECYCLE_RSS_GB=17
# ORACLE_MAX_BATCH=256
